PORT=5000
NODE_ENV=development

# Native PostgreSQL Database Settings
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ilearner_db
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/ilearner_db
PGDATA_DIR=/home/gtechsources/com-ilearner/ilearner-backend/pgdata

# Auth & Frontend
JWT_SECRET=super_secret_jwt_key_ilearner_2026_xyz
FRONTEND_URL=http://localhost:3000

# Amazon Product Advertising API (PA-API v5) Credentials
AMAZON_ACCESS_KEY=your_aws_access_key_here
AMAZON_SECRET_KEY=your_aws_secret_key_here
AMAZON_PARTNER_TAG=linkcraft-20

# WhatsApp Official Business API Configuration
# Provider: 'meta' (Meta WhatsApp Cloud API) or 'twilio' (Twilio WhatsApp API)
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (developers.facebook.com)
META_WHATSAPP_TOKEN=your_meta_system_user_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_from_meta_dashboard
META_VERIFY_TOKEN=ilearner_whatsapp_verify_token_2026
META_BUSINESS_ACCOUNT_ID=your_waba_account_id_here
META_API_VERSION=v21.0

# Twilio WhatsApp API (Alternative official business provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Bot Public Display Number (displayed on frontend pairing cards)
BOT_PHONE_NUMBER=+92 3181494914

